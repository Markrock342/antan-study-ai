{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antan-study-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "DOCS", "class_name": "DocStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocStore"] }],
  "vars": {
    "CHAT_MODEL": "@cf/aisingapore/gemma-sea-lion-v4-27b-it",
    "EMBED_MODEL": "@cf/baai/bge-m3"
  },
  "observability": { "enabled": true }
}
